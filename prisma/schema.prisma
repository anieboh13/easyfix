// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  sourceUrl   String
  sourceId    String   @unique
  title       String
  description String?
  basePrice   Float
  markupType  String
  markupValue Float
  finalPrice  Float
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  status      String   @default("active")
  lastCheckedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  images        ProductImage[]
  priceHistory  PriceHistory[]
  variants      ProductVariant[]
  orderIntents  OrderIntent[]
}

model ProductImage {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  storageUrl String
  thumbnailUrl String?
}

model PriceHistory {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  price     Float
  checkedAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model MarkupRule {
  id      String  @id @default(cuid())
  scope   String
  scopeId String?
  type    String
  value   Float
  createdAt DateTime @default(now())
}

model ImportLog {
  id        String   @id @default(cuid())
  type      String   // 'success' | 'error'
  message   String?
  sourceId  String?
  createdAt DateTime @default(now())
}

model ProductVariant {
  id              String   @id @default(cuid())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  label           String   // raw AliExpress color/variant label, shown as-is
  aliexpressSkuId String?  // AliExpress's sku_id — reference only, confirmed NOT reliably unique
  basePrice       Float    // USD, from sale_price_with_tax
  finalPrice      Float    // after markup engine
  imageUrl        String?  // cached copy of sku_image_link
  affiliateLink   String   // pre-tracked AliExpress link — never shown to customers directly
  createdAt       DateTime @default(now())
}

model AliexpressToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model OrderIntent {
  id              String   @id @default(cuid())
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  productTitle    String   // snapshot — stays readable even if the product is later deleted
  variantId       String?  // snapshot only, NOT a foreign key — variant rows get replaced on refresh
  variantLabel    String?
  price           Float    // final Naira price shown to the customer at click time
  affiliateLink   String?  // snapshot — what the owner needs to actually place the AliExpress order
  sourceUrl       String?  // fallback trace-back if no variant was selected
  aliexpressSkuId String?
  whatsappNumber  String
  createdAt       DateTime @default(now())
}